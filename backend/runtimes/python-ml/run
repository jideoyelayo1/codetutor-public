#!/bin/bash
set -euo pipefail
if [ "$#" -ne 1 ]; then
    echo "Expected one Python source file" >&2
    exit 2
fi
# No user-site packages, bytecode writes, GPU selection, or uncontrolled BLAS pools.
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 CUDA_VISIBLE_DEVICES=""
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
exec python3.13 -I -B "$1"
